  (text "Write DEBUGX = 1\nWrite address and data\nWrite OPX = required OP\n - repeat write for auto-incrementing memory writes\nRead ML for low byte of read data\nRead MH for high byte and trigger address auto-increment"
    (at 17.78 170.18 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 0563574a-d3c3-46ec-b156-d323b45d53c1)
  )
  (text "OPX\n000 - RUN\n001 - STEP\n010 - Write memory\n011 - Read memory\n100 - Read register\n101 - Read PC register\n110 - Read CC register"
    (at 19.05 189.23 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 5eb0db99-2dbe-40b4-b6b8-aa4bcce33557)
  )


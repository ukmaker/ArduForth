  (text "LD Ra,(Rb)\n  - REGA_ADDRX = ARGA_X\n  - WRA_EN = 1\n  - REGA_DINX = DIN\n  - ALUA_SRCX = 0 (IGN)\n  - ALU_OPX = MOV (IGN)\n  - REGB_ADDRX = ARGB_X\n  - RDB_EN = 1\n  - ABUS_X = REGB\n  - MEM_READ = 1\n\nLD Ra,(Rb++)\n  - REGA_ADDRX = ARGA_X\n  - WRA_EN = 1\n  - REGA_DINX = DIN\n\n  - ALUA_SRCX = 2 (1 for Byte ops)\n  - ALU_OPX = PLUS\n  - REGB_ADDRX = ARGB_X\n  - RDB_EN = 1\n  - WRB_EN = 1\n  - REGB_DINX = ALU_R\n  - ABUS_X = REGB\n  - MEM_READ = 1\n\nLD Ra,(--Rb)\n  - REGA_ADDRX = ARGA_X\n  - WRA_EN = 1\n  - REGA_DINX = DIN\n\n  - ALUA_SRCX = 2\n  - ALU_OPX = MINUS\n  - REGB_ADDRX = ARGB_X\n  - RDB_EN = 1\n  - WRB_EN = 1\n  - REGB_DINX = ALU_R\n  - ABUS_X = ALU_R\n  - MEM_READ = 1\n"
    (at 312.42 243.84 0)
    (effects (font (face "Consolas") (size 1.27 1.27)) (justify left bottom))
    (uuid b277df69-5121-4c70-98e4-418955066767)

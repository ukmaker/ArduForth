  (text "SKIPF           JPF                CCF \n--------------------------------------------\n0 0 - Always    0 0 - JP Rb        0 0 - CCC\n0 1 - Always    0 1 - JP U8H.RBL   0 1 - CCZ\n1 0 - CC Match  1 0 - JR Rb        1 0 - CCP\n1 1 - CC !Match 1 1 - JR U8H.RBL   1 1 - CCM\n\nJP Rb\n  - CC_APPLYX = 0\n  - PC_BASEX = 0\n  - PC_OFFSETX = PC_D\n  - PC_EN = 1\n  - JMP_X = 1\n  - REGB_ADDRX = ARGB_X\n  - REGB_EN = 1\n  - REGA_ADDRX = RL\n  - REGA_WEN = 1\n  - REGA_DINX = PC_A"

  (text_box "INT0 INT1  RETI  DI   EI  STATE  - PC_NEXTX   PC_LD_INT0 PC_LD_INT1 EI_INT   ; STATE_NEXT\n------------------------------------------------------------------------------------------\n  0    0    0     0    0    *    - PC_A_NEXT      0          0         0     ; RUN (From RESET)\n\n\n  0    0    0     0    0    *    - PC_A_NEXT      0          0         -     ; STATE\n  0    0    0     0    1    *    - PC_A_NEXT      0          0         1     ; STATE\n  0    0    0     1    0    *    - PC_A_NEXT      0          0         0     ; STATE\n  0    0    0     1    1    *    - PC_A_NEXT      0          0         0     ; STATE (Invalid decode)\n  0    0    1     *    *   RI1   - INT_R_1        0          0         -     ; RUN   (Normal return)\n  0    0    1     *    *   RI1_0 - INT_R_0        0          0         -     ; RI1   (Return from nested NMI)\n  0    0    1     *    *   RI0   - INT_R_0        0          0         -     ; RUN   (Normal return from NMI)\n\n  0    1    0     *    *   RUN   - PC_A_NEXT      0          0         0     ; RUN   (Ignored interrupt)\n  0    1    0     *    *   RUN   - INT_V_1        0          1         1     ; RI1   (INT1)\n  0    1    0     *    *   RI1   - PC_A_NEXT      0          0         *     ; RI1   (Ignored nested interrupt)\n  0    1    1     *    *   RI1   - INT_R_1        0          0         *     ; RUN   (Return takes priority)\n\n  1    *    0     *    *   RUN   - INT_V_0        1          0         -     ; RI0   (NMI)\n\n  1    *    0     *    *   RI1   - INT_V_0        1          0         *     ; RI1_0 (Nested NMI)\n  1    *    1     *    *   RI1   - INT_V_0        1          0         *     ; RI0   (NMI takes priority)\n\n  1    *    0     *    *   RI0   - PC_A_NEXT      0          0         *     ; RI0   (Ignored nested interrupt)\n  1    *    1     *    *   RI0   - INT_R_0        0          0         *     ; RUN   (Return takes priority)\n\n"
    (at 298.45 160.02 0) (size 102.87 46.99)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (face "Lucida Console") (size 1 1)) (justify left top))

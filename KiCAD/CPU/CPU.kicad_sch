  (text "ST (FP++ +U4),Ra\n------------------\n\nALUB_SRCX = U4\nALUA_SRCX = ALUA_PP\n\nREGA_ADDRX = FP\nREGB_ADDRX = ARGBX\n\nABYS_X = ALU_R\nDBUS_X = REGA_DOUT"
